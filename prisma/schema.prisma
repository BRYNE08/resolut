// Resolut — Prisma schema (plug-and-play).
//
// Nothing in the app talks to a database yet: the repository layer falls back to
// in-memory sample data whenever DATABASE_URL is unset. To go live:
//
//   1. bun add -d prisma && bun add @prisma/client
//   2. set DATABASE_URL in the environment
//   3. bunx prisma migrate dev --name init && bunx prisma generate
//
// src/lib/data/repository.server.ts then picks the Prisma adapter automatically.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  runtime  = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- catalogue

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String
  intro       String
  badge       String?
  body        String[]
  /// Price in cents (ZAR). Null means "coming soon".
  priceCents  Int?
  images      String[] @default([])
  image       String
  imageAlt    String
  detailImage String
  specs       Json
  details     Json
  published   Boolean  @default(true)
  /// Monthly production capacity for the studio dashboard.
  capacity    Int      @default(12)
  readyStock  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems      OrderItem[]
  waitlistEntries WaitlistSignup[]
  productionJobs  ProductionJob[]
  cartItems       CartItem[]

  @@index([published])
}

// ---------------------------------------------------------------- commerce

enum OrderStatus {
  AWAITING_PAYMENT
  PAID
  IN_PRODUCTION
  SHIPPED
  CANCELLED
}

model Order {
  id            String      @id @default(cuid())
  reference     String      @unique
  status        OrderStatus @default(AWAITING_PAYMENT)
  customerName  String
  email         String
  phone         String?
  addressLine   String
  addressLine2  String?
  suburb        String?
  city          String
  province      String      @default("")
  postalCode    String
  country       String      @default("South Africa")
  deliveryNotes String?
  /// Totals in cents (ZAR).
  subtotalCents Int
  shippingCents Int         @default(0)
  totalCents    Int
  /// PayFast payment identifier — never store raw bank details.
  paymentRef    String?
  notes         String?
  userId        String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]
  jobs  ProductionJob[]

  @@index([status, createdAt])
  @@index([userId])
}

model OrderItem {
  id             String @id @default(cuid())
  orderId        String
  productId      String
  quantity       Int    @default(1)
  unitPriceCents Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

// ------------------------------------------------------------------ carts
// Anonymous carts keyed by the sealed `resolut_cart` cookie. No account needed.

model Cart {
  id        String     @id @default(cuid())
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  items CartItem[]
}

model CartItem {
  id        String @id @default(cuid())
  cartId    String
  productId String
  quantity  Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([cartId])
}

model ProductionJob {
  id        String   @id @default(cuid())
  title     String
  detail    String
  dueAt     DateTime?
  overdue   Boolean  @default(false)
  productId String?
  orderId   String?
  createdAt DateTime @default(now())

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------- audience

model WaitlistSignup {
  id        String   @id @default(cuid())
  email     String
  label     String
  productId String?
  createdAt DateTime @default(now())

  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([email, label])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  handled   Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ------------------------------------------------- Auth.js (@auth/prisma-adapter)

enum UserRole {
  CUSTOMER
  STUDIO
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(CUSTOMER)
  passwordHash  String?
  sessionVersion Int      @default(0)
  createdAt     DateTime  @default(now())

  accounts Account[]
  sessions Session[]
  orders   Order[]
}

/// Shared, expiring authentication attempt counters. Keys are HMACs, never raw IPs/emails.
model AuthRateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Saved contact + delivery details for a signed-in customer.
/// New rows use "customer:<userId>" in the legacy accountEmail key column.
/// Older email-keyed rows can be read only after verifying ownership of that email.
model CustomerProfile {
  id            String   @id @default(cuid())
  accountEmail  String   @unique
  contactEmail  String
  phone         String?
  addressLine   String?
  addressLine2  String?
  suburb        String?
  city          String?
  province      String?
  postalCode    String?
  country       String   @default("South Africa")
  deliveryNotes String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
