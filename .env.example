# Resolut — plug-and-play environment.
# The app runs with this file empty: no DATABASE_URL means in-memory sample data,
# no AUTH_SECRET means a demo studio session.

# ---- Prisma -----------------------------------------------------------------
# Set this, run `bunx prisma migrate dev`, and the Prisma adapter takes over.
DATABASE_URL=

# ---- Auth.js ----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:8080

AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_RESEND_KEY=

# ---- Studio sign-in ---------------------------------------------------------
# Credential accounts for /signin. Leave blank to keep the demo accounts
# (studio@resolutdesign.co.za / resolut-studio, admin@resolutdesign.co.za /
# resolut-admin), which the sign-in page lists while unset.
STUDIO_EMAIL=
STUDIO_PASSWORD=
STUDIO_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# ---- Payments ---------------------------------------------------------------
# PayFast hosted checkout — never store raw bank details yourself.
# Leave blank to run against PayFast's public sandbox merchant.
PAYFAST_MERCHANT_ID=
PAYFAST_MERCHANT_KEY=
PAYFAST_PASSPHRASE=
# Force sandbox/live explicitly: "true" or "false".
PAYFAST_SANDBOX=
# Absolute site URL used for PayFast return/cancel/notify URLs.
PUBLIC_SITE_URL=

# UploadThing (optional) — studio image uploads. Unset = images are inlined.
UPLOADTHING_TOKEN=
